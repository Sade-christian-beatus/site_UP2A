# Copier ce fichier en .env.local et renseigner les vraies valeurs.
# Ne jamais committer .env.local (voir .gitignore).

# Clé publique — utilisable côté navigateur (protégée par la RLS).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé privée — SERVEUR UNIQUEMENT. Jamais de préfixe NEXT_PUBLIC_.
# Utilisée uniquement dans des route handlers / server actions qui en ont
# explicitement besoin (ex. création de compte auth.users depuis le
# back-office). Voir docs/01-architecture.md et docs/04-conventions.md.
SUPABASE_SERVICE_ROLE_KEY=
