# Copier ce fichier en .env.local et renseigner les vraies valeurs.
# Ne jamais committer .env.local (voir .gitignore).

# Clé publique — utilisable côté navigateur (protégée par la RLS).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL du back-office (application séparée depuis la scission des deux
# espaces) — utilisée pour rediriger un compte "admin" qui essaierait
# d'accéder à l'espace étudiant, au lieu d'une boucle de redirection
# interne. Voir lib/auth/dal.ts.
NEXT_PUBLIC_BACKOFFICE_URL=https://admin.bdo-burkina.com

# Aucune clé service_role ici : cette app est désormais lecture seule
# côté étudiant (phase 6), toutes les mutations (candidatures,
# résultats, etc.) vivent dans l'app back-office. Voir
# docs/01-architecture.md.
