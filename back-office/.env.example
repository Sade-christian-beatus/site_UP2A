# Copier ce fichier en .env.local et renseigner les vraies valeurs.
# Ne jamais committer .env.local (voir .gitignore).

# Mêmes valeurs Supabase que app-etudiant (même projet, RLS partagée).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé privée — SERVEUR UNIQUEMENT. Jamais de préfixe NEXT_PUBLIC_.
# Utilisée uniquement pour créer un compte auth.users lors de la
# transformation d'une candidature en étudiant (voir
# docs/01-architecture.md, Flux 3). app-etudiant (espace étudiant) n'a
# plus besoin de cette clé depuis la séparation des deux apps.
SUPABASE_SERVICE_ROLE_KEY=

# URL de l'espace étudiant (app-etudiant) — utilisée pour rediriger un
# compte "etudiant" qui essaierait d'accéder au back-office, au lieu
# d'une boucle de redirection interne. Voir lib/auth/dal.ts.
NEXT_PUBLIC_ESPACE_ETUDIANT_URL=https://espace.bdo-burkina.com
